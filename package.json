{
  "name": "science-agent",
  "version": "0.7.1",
  "description": "Improve scientific collaboration in AI-assisted research. Citation validation, claim verification, cross-file consistency.",
  "main": "cli.js",
  "bin": {
    "science-agent": "./cli.js"
  },
  "scripts": {
    "audit": "node cli.js audit",
    "test": "npm run test:cli-guard && npm run test:bibtex && npm run test:citations && npm run test:bib-metadata && npm run test:prose && npm run test:notebook && npm run test:repro",
    "test:citations": "node cli.js audit ./test-fixtures --bibtex=./test-fixtures/refs.bib --offline",
    "test:bibtex": "node tools/bibtex-eval.js",
    "test:bib-metadata": "node tools/citation-eval.js",
    "test:prose": "node tools/prose-eval.js",
    "test:notebook": "node tools/notebook-eval.js",
    "test:repro": "node tools/repro-eval.js",
    "test:cli-guard": "node tools/cli-guard-eval.js"
  },
  "keywords": [
    "science",
    "citation",
    "academic",
    "confabulation",
    "ai",
    "verification",
    "bibtex",
    "crossref",
    "research"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andyed/science-agent.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "cli.js",
    "src/",
    "agent.md",
    "docs/",
    "README.md",
    "CHANGELOG.md"
  ],
  "author": "Andy Edmonds <andyed@gmail.com>",
  "license": "MIT",
  "type": "commonjs"
}

{
  "name": "science-agent",
  "version": "0.6.0",
  "description": "Improve scientific collaboration in AI-assisted research. Citation validation, claim verification, cross-file consistency.",
  "main": "cli.js",
  "bin": {
    "science-agent": "./cli.js"
  },
  "scripts": {
    "audit": "node cli.js audit",
    "test": "npm run test:citations && npm run test:prose && npm run test:notebook",
    "test:citations": "node cli.js audit ./test-fixtures --bibtex=./test-fixtures/refs.bib",
    "test:prose": "node tools/prose-eval.js",
    "test:notebook": "node tools/notebook-eval.js"
  },
  "keywords": ["science", "citation", "academic", "confabulation", "ai", "verification", "bibtex", "crossref", "research"],
  "repository": {
    "type": "git",
    "url": "https://github.com/andyed/science-agent.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "cli.js",
    "src/",
    "agent.md",
    "docs/",
    "README.md",
    "CHANGELOG.md"
  ],
  "author": "Andy Edmonds <andyed@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bibtex-parse-js": "^0.0.24",
    "fuse.js": "^7.1.0"
  }
}
